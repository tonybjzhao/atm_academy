  "@whatIsAtmQ2Question": {},
  "whatIsAtmQ2O0": "Air Traffic Control",
  "@whatIsAtmQ2O0": {},
  "whatIsAtmQ2O1": "Airline ticketing",
  "@whatIsAtmQ2O1": {},
  "whatIsAtmQ2O2": "Airspace Management",
  "@whatIsAtmQ2O2": {},
  "whatIsAtmQ2Explanation": "Airline ticketing is a commercial function, not part of ATM. The three pillars are ATC, ASM, and ATFM.",
  "@whatIsAtmQ2Explanation": {},
  "whatIsAtmQ3Question": "What is the primary goal of ATM?",
  "@whatIsAtmQ3Question": {},
  "whatIsAtmQ3O0": "Maximize airline profit",
  "@whatIsAtmQ3O0": {},
  "whatIsAtmQ3O1": "Safety and efficient movement of aircraft",
  "@whatIsAtmQ3O1": {},
  "whatIsAtmQ3O2": "Reduce fuel prices",
