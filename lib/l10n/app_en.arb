  "whatIsAtmTitle": "What is ATM?",
  "@whatIsAtmTitle": {},
  "whatIsAtmSummary": "Air Traffic Management keeps aircraft moving safely and efficiently across the world.",
  "@whatIsAtmSummary": {},
  "whatIsAtmPoint1": "ATM = Air Traffic Management: the dynamic, integrated management of air traffic.",
  "@whatIsAtmPoint1": {},
  "whatIsAtmPoint2": "Three pillars: Air Traffic Control (ATC), Airspace Management (ASM), Air Traffic Flow Management (ATFM).",
  "@whatIsAtmPoint2": {},
  "whatIsAtmPoint3": "Core goals: Safety, Efficiency, Order, and Capacity.",
  "@whatIsAtmPoint3": {},
  "whatIsAtmQ1Question": "What does ATM stand for?",
  "@whatIsAtmQ1Question": {},
  "whatIsAtmQ1O0": "Automated Teller Machine",
  "@whatIsAtmQ1O0": {},
  "whatIsAtmQ1O1": "Air Traffic Management",
  "@whatIsAtmQ1O1": {},
  "whatIsAtmQ1O2": "Aircraft Terminal Monitor",
  "@whatIsAtmQ1O2": {},
  "whatIsAtmQ1Explanation": "ATM stands for Air Traffic Management — the system that keeps all aircraft safe and efficient.",
  "@whatIsAtmQ1Explanation": {},
