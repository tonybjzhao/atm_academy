  "courseHomeTitle": "ATM Courses",
  "@courseHomeTitle": {},
  "lesson1Title": "What is ATM?",
  "@lesson1Title": {},
  "lesson1Summary": "Air Traffic Management keeps aircraft moving safely and efficiently.",
  "@lesson1Summary": {},
  "lesson1Content1": "ATM means Air Traffic Management.",
  "@lesson1Content1": {},
  "lesson1Content2": "It includes air traffic control, airspace management, and traffic flow management.",
  "@lesson1Content2": {},
  "lesson1Content3": "The main goals are safety, efficiency, order, and capacity.",
  "@lesson1Content3": {},
  "lesson1Q1Question": "What is the main goal of ATM?",
  "@lesson1Q1Question": {},
  "lesson1Q1Option0": "Sell airline tickets",
  "@lesson1Q1Option0": {},
  "lesson1Q1Option1": "Keep aircraft safe and efficiently managed",
  "@lesson1Q1Option1": {},
  "lesson1Q1Option2": "Repair aircraft engines",
  "@lesson1Q1Option2": {},
  "lesson1Q1Explanation": "ATM focuses on safe, orderly, and efficient aircraft movement.",
  "@lesson1Q1Explanation": {},
  "lesson2Title": "Tower, Approach, and En-route",
  "@lesson2Title": {},
  "lesson2Summary": "Different controllers manage different phases of flight.",
  "@lesson2Summary": {},
  "lesson2Content1": "Tower controls runways, takeoff, landing, and ground movement near the airport.",
  "@lesson2Content1": {},
  "lesson2Content2": "Approach controls aircraft arriving to or leaving an airport area.",
  "@lesson2Content2": {},
  "lesson2Content3": "En-route controls aircraft during cruise between airports.",
  "@lesson2Content3": {},
  "lesson2Q1Question": "Which unit usually controls aircraft landing on the runway?",
  "@lesson2Q1Question": {},
  "lesson2Q1Option0": "Tower",
  "@lesson2Q1Option0": {},
  "lesson2Q1Option1": "Airline office",
  "@lesson2Q1Option1": {},
  "lesson2Q1Option2": "Baggage service",
  "@lesson2Q1Option2": {},
  "lesson2Q1Explanation": "Tower manages runway operations including takeoff and landing.",
  "@lesson2Q1Explanation": {},
  "lesson3Title": "Runway, Taxiway, and Holding Point",
  "@lesson3Title": {},
  "lesson3Summary": "Airports have controlled movement areas.",
  "@lesson3Summary": {},
  "lesson3Content1": "A runway is used for takeoff and landing.",
  "@lesson3Content1": {},
  "lesson3Content2": "A taxiway is used for aircraft movement on the ground.",
  "@lesson3Content2": {},
  "lesson3Content3": "A holding point is where aircraft wait before entering a runway.",
  "@lesson3Content3": {},
  "lesson3Q1Question": "Where should an aircraft wait before entering a runway?",
  "@lesson3Q1Question": {},
  "lesson3Q1Option0": "Holding point",
  "@lesson3Q1Option0": {},
  "lesson3Q1Option1": "Passenger gate only",
  "@lesson3Q1Option1": {},
  "lesson3Q1Option2": "Cruise level",
  "@lesson3Q1Option2": {},
  "lesson3Q1Explanation": "Holding points protect runway safety.",
  "@lesson3Q1Explanation": {},
  "lesson4Title": "Flight Plan Basics",
  "@lesson4Title": {},
  "lesson4Summary": "A flight plan tells the ATM system where an aircraft intends to fly.",
  "@lesson4Summary": {},
  "lesson4Content1": "A flight plan includes aircraft identity, route, departure, destination, and timing.",
  "@lesson4Content1": {},
  "lesson4Content2": "Controllers use flight plans to predict traffic.",
  "@lesson4Content2": {},
  "lesson4Content3": "Good planning helps reduce conflicts.",
  "@lesson4Content3": {},
  "lesson4Q1Question": "Why are flight plans important?",
  "@lesson4Q1Question": {},
  "lesson4Q1Option0": "They help predict and manage traffic",
  "@lesson4Q1Option0": {},
  "lesson4Q1Option1": "They replace pilots",
  "@lesson4Q1Option1": {},
  "lesson4Q1Option2": "They control weather",
  "@lesson4Q1Option2": {},
  "lesson4Q1Explanation": "Flight plans help controllers and systems understand intended aircraft movement.",
  "@lesson4Q1Explanation": {},
  "lesson5Title": "Separation Basics",
  "@lesson5Title": {},
  "lesson5Summary": "Separation keeps aircraft safely apart.",
  "@lesson5Summary": {},
  "lesson5Content1": "Separation means keeping enough distance between aircraft.",
  "@lesson5Content1": {},
  "lesson5Content2": "Separation can be vertical, lateral, or longitudinal.",
  "@lesson5Content2": {},
  "lesson5Content3": "Loss of separation is a serious safety risk.",
  "@lesson5Content3": {},
  "lesson5Q1Question": "What does separation mean in ATM?",
  "@lesson5Q1Question": {},
  "lesson5Q1Option0": "Keeping aircraft safely apart",
  "@lesson5Q1Option0": {},
  "lesson5Q1Option1": "Parking aircraft close together",
  "@lesson5Q1Option1": {},
  "lesson5Q1Option2": "Making aircraft fly faster",
  "@lesson5Q1Option2": {},
  "lesson5Q1Explanation": "Separation is one of the core safety concepts in ATM.",
  "@lesson5Q1Explanation": {},
  "lesson6Title": "Sequencing and Spacing",
  "@lesson6Title": {},
  "lesson6Summary": "Controllers organise aircraft into a safe and efficient order.",
  "@lesson6Summary": {},
  "lesson6Content1": "Sequencing means deciding the order of aircraft.",
  "@lesson6Content1": {},
  "lesson6Content2": "Spacing means keeping suitable gaps between aircraft.",
  "@lesson6Content2": {},
  "lesson6Content3": "Good sequencing improves runway capacity and reduces delay.",
  "@lesson6Content3": {},
  "lesson6Q1Question": "What is sequencing?",
  "@lesson6Q1Question": {},
  "lesson6Q1Option0": "Choosing aircraft order",
  "@lesson6Q1Option0": {},
  "lesson6Q1Option1": "Painting runway numbers",
  "@lesson6Q1Option1": {},
  "lesson6Q1Option2": "Loading baggage",
  "@lesson6Q1Option2": {},
  "lesson6Q1Explanation": "Sequencing determines the safe and efficient order of traffic.",
  "@lesson6Q1Explanation": {},
  "lesson7Title": "Weather Impact",
  "@lesson7Title": {},
  "lesson7Summary": "Weather can reduce capacity and increase workload.",
  "@lesson7Summary": {},
  "lesson7Content1": "Thunderstorms, fog, wind, and low visibility affect ATM decisions.",
  "@lesson7Content1": {},
  "lesson7Content2": "Bad weather may reduce arrival and departure rates.",
  "@lesson7Content2": {},
  "lesson7Content3": "Controllers must balance safety and efficiency.",
  "@lesson7Content3": {},
  "lesson7Q1Question": "What can bad weather cause?",
  "@lesson7Q1Question": {},
  "lesson7Q1Option0": "Reduced airport capacity",
  "@lesson7Q1Option0": {},
  "lesson7Q1Option1": "Free fuel",
  "@lesson7Q1Option1": {},
  "lesson7Q1Option2": "No need for separation",
  "@lesson7Q1Option2": {},
  "lesson7Q1Explanation": "Weather often reduces capacity and increases delay.",
  "@lesson7Q1Explanation": {},
  "lesson8Title": "Emergency and Abnormal Situations",
  "@lesson8Title": {},
  "lesson8Summary": "Emergencies require priority, calm decisions, and coordination.",
  "@lesson8Summary": {},
  "lesson8Content1": "Emergencies may include low fuel, medical events, radio failure, or technical problems.",
  "@lesson8Content1": {},
  "lesson8Content2": "Controllers give priority and coordinate with other units.",
  "@lesson8Content2": {},
  "lesson8Content3": "Clear communication is critical.",
  "@lesson8Content3": {},
  "lesson8Q1Question": "What should ATM prioritise during an emergency?",
  "@lesson8Q1Question": {},
  "lesson8Q1Option0": "Safety",
  "@lesson8Q1Option0": {},
  "lesson8Q1Option1": "Advertising",
  "@lesson8Q1Option1": {},
  "lesson8Q1Option2": "Entertainment",
  "@lesson8Q1Option2": {},
  "lesson8Q1Explanation": "Safety is always the first priority in emergency handling.",
  "@lesson8Q1Explanation": {},
  "lesson9Title": "ATFCM and Flow Management",
  "@lesson9Title": {},
  "lesson9Summary": "Flow management balances demand and capacity.",
  "@lesson9Summary": {},
  "lesson9Content1": "ATFCM means Air Traffic Flow and Capacity Management.",
  "@lesson9Content1": {},
  "lesson9Content2": "It helps avoid overload in airports, sectors, and routes.",
  "@lesson9Content2": {},
  "lesson9Content3": "Measures may include delay programs, rerouting, or capacity planning.",
  "@lesson9Content3": {},
  "lesson9Q1Question": "What is the purpose of ATFCM?",
  "@lesson9Q1Question": {},
  "lesson9Q1Option0": "Balance traffic demand and capacity",
  "@lesson9Q1Option0": {},
  "lesson9Q1Option1": "Sell aircraft",
  "@lesson9Q1Option1": {},
  "lesson9Q1Option2": "Replace airports",
  "@lesson9Q1Option2": {},
  "lesson9Q1Explanation": "ATFCM manages traffic flow so the system does not become overloaded.",
  "@lesson9Q1Explanation": {},
  "lesson10Title": "Human Factors and Workload",
  "@lesson10Title": {},
  "lesson10Summary": "ATM safety depends on people, systems, and good decision making.",
  "@lesson10Summary": {},
  "lesson10Content1": "Controllers need situational awareness.",
  "@lesson10Content1": {},
  "lesson10Content2": "High workload can increase error risk.",
  "@lesson10Content2": {},
  "lesson10Content3": "Good interface design, training, and teamwork improve safety.",
  "@lesson10Content3": {},
  "lesson10Q1Question": "What is situational awareness?",
  "@lesson10Q1Question": {},
  "lesson10Q1Option0": "Understanding what is happening now and what may happen next",
  "@lesson10Q1Option0": {},
  "lesson10Q1Option1": "Ignoring aircraft positions",
  "@lesson10Q1Option1": {},
  "lesson10Q1Option2": "Only looking at weather",
  "@lesson10Q1Option2": {},
  "lesson10Q1Explanation": "Situational awareness helps controllers make safe decisions.",
  "@lesson10Q1Explanation": {},

