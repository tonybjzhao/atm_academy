  "futureAtmQ2O1": "Managing smaller airports from a centralised facility",
  "@futureAtmQ2O1": {},
  "futureAtmQ2O2": "Removing the need for radar entirely",
  "@futureAtmQ2O2": {},
  "futureAtmQ2Explanation": "Remote towers use cameras and digital feeds to give controllers a full view of small airports from a remote location.",
