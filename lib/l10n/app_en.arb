  "futureAtmQ1Explanation": "SESAR (Single European Sky ATM Research) is the European programme to modernise and harmonise ATM across Europe.",
  "@futureAtmQ1Explanation": {},
  "futureAtmQ2Question": "Remote towers allow:",
  "@futureAtmQ2Question": {},
  "futureAtmQ2O0": "Controlling airports without any human oversight",
