  "whatIsAtmQ3Explanation": "Safety is always the first priority in ATM, followed by efficiency and order.",
  "@whatIsAtmQ3Explanation": {},

  "airspaceBasicsTitle": "Airspace Basics",
  "@airspaceBasicsTitle": {},
  "airspaceBasicsSummary": "Airspace is divided into classes and regions to manage traffic safely.",
  "@airspaceBasicsSummary": {},
  "airspaceBasicsPoint1": "Airspace classes A–G define rules for who can fly there and what services they receive.",
  "@airspaceBasicsPoint1": {},
  "airspaceBasicsPoint2": "Controlled airspace requires ATC clearance. Uncontrolled airspace (Class G) does not.",
  "@airspaceBasicsPoint2": {},
  "airspaceBasicsPoint3": "A Flight Information Region (FIR) is a large volume of airspace managed by one centre.",
  "@airspaceBasicsPoint3": {},
  "airspaceBasicsQ1Question": "Class A airspace is:",
  "@airspaceBasicsQ1Question": {},
  "airspaceBasicsQ1O0": "Fully controlled, IFR only",
  "@airspaceBasicsQ1O0": {},
  "airspaceBasicsQ1O1": "Uncontrolled, VFR only",
  "@airspaceBasicsQ1O1": {},
  "airspaceBasicsQ1O2": "Open to all without clearance",
  "@airspaceBasicsQ1O2": {},
  "airspaceBasicsQ1Explanation": "Class A is the most restrictive: only IFR flights with ATC clearance are allowed.",
  "@airspaceBasicsQ1Explanation": {},
  "airspaceBasicsQ2Question": "What is a FIR?",
  "@airspaceBasicsQ2Question": {},
  "airspaceBasicsQ2O0": "A type of aircraft radar",
  "@airspaceBasicsQ2O0": {},
  "airspaceBasicsQ2O1": "Flight Information Region",
  "@airspaceBasicsQ2O1": {},
  "airspaceBasicsQ2O2": "A runway marking system",
  "@airspaceBasicsQ2O2": {},
  "airspaceBasicsQ2Explanation": "A FIR (Flight Information Region) is a defined volume of airspace managed by an air traffic services provider.",
  "@airspaceBasicsQ2Explanation": {},
  "airspaceBasicsQ3Question": "Which class requires no ATC clearance?",
  "@airspaceBasicsQ3Question": {},
  "airspaceBasicsQ3O0": "Class A",
  "@airspaceBasicsQ3O0": {},
  "airspaceBasicsQ3O1": "Class C",
  "@airspaceBasicsQ3O1": {},
  "airspaceBasicsQ3O2": "Class G",
  "@airspaceBasicsQ3O2": {},
  "airspaceBasicsQ3Explanation": "Class G is uncontrolled airspace — flights operate without ATC clearance, though information services may exist.",
  "@airspaceBasicsQ3Explanation": {},

  "radarBasicsTitle": "Radar Basics",
  "@radarBasicsTitle": {},
  "radarBasicsSummary": "Radar is the primary tool controllers use to see aircraft position and movement.",
  "@radarBasicsSummary": {},
  "radarBasicsPoint1": "Primary Surveillance Radar (PSR) detects reflections of radio waves off aircraft.",
  "@radarBasicsPoint1": {},
  "radarBasicsPoint2": "Secondary Surveillance Radar (SSR) interrogates transponders — giving callsign, altitude, and speed.",
  "@radarBasicsPoint2": {},
  "radarBasicsPoint3": "Aircraft appear as \"blips\" on the display, updated each radar rotation (typically 4–12 seconds).",
  "@radarBasicsPoint3": {},
  "radarBasicsQ1Question": "What does SSR stand for?",
  "@radarBasicsQ1Question": {},
  "radarBasicsQ1O0": "Secondary Surveillance Radar",
  "@radarBasicsQ1O0": {},
  "radarBasicsQ1O1": "Speed and Separation Record",
  "@radarBasicsQ1O1": {},
  "radarBasicsQ1O2": "Standard Separation Rule",
  "@radarBasicsQ1O2": {},
  "radarBasicsQ1Explanation": "SSR (Secondary Surveillance Radar) interrogates aircraft transponders to provide identification and altitude data.",
  "@radarBasicsQ1Explanation": {},
  "radarBasicsQ2Question": "What is an aircraft \"blip\" on radar?",
  "@radarBasicsQ2Question": {},
  "radarBasicsQ2O0": "A sound the controller hears",
  "@radarBasicsQ2O0": {},
  "radarBasicsQ2O1": "A visual indicator of the aircraft position",
  "@radarBasicsQ2O1": {},
  "radarBasicsQ2O2": "An error in the radar system",
  "@radarBasicsQ2O2": {},
  "radarBasicsQ2Explanation": "A blip is the return shown on the radar display representing the aircraft's detected position.",
  "@radarBasicsQ2Explanation": {},
  "radarBasicsQ3Question": "Primary radar works by:",
  "@radarBasicsQ3Question": {},
  "radarBasicsQ3O0": "Asking aircraft to send their position",
  "@radarBasicsQ3O0": {},
  "radarBasicsQ3O1": "Detecting reflected radio waves off the aircraft",
  "@radarBasicsQ3O1": {},
  "radarBasicsQ3O2": "Using GPS satellite data",
  "@radarBasicsQ3O2": {},
  "radarBasicsQ3Explanation": "Primary radar emits radio pulses and detects the echo reflected back from aircraft.",
  "@radarBasicsQ3Explanation": {},

  "separationBasicsTitle": "Separation Basics",
  "@separationBasicsTitle": {},
  "separationBasicsSummary": "Maintaining separation between aircraft is the core safety task of ATC.",
  "@separationBasicsSummary": {},
  "separationBasicsPoint1": "Vertical separation: aircraft at different altitudes (e.g., 1000 ft minimum below FL290).",
  "@separationBasicsPoint1": {},
  "separationBasicsPoint2": "Horizontal separation: lateral (side-by-side) and longitudinal (one behind another).",
  "@separationBasicsPoint2": {},
  "separationBasicsPoint3": "A Loss of Separation (LOS) is a serious incident and must be reported and investigated.",
  "@separationBasicsPoint3": {},
  "separationBasicsQ1Question": "What is vertical separation?",
  "@separationBasicsQ1Question": {},
  "separationBasicsQ1O0": "Aircraft side by side at same altitude",
  "@separationBasicsQ1O0": {},
  "separationBasicsQ1O1": "Aircraft at different altitudes",
  "@separationBasicsQ1O1": {},
  "separationBasicsQ1O2": "Aircraft separated by time only",
  "@separationBasicsQ1O2": {},
  "separationBasicsQ1Explanation": "Vertical separation keeps aircraft at different flight levels to prevent collision.",
  "@separationBasicsQ1Explanation": {},
  "separationBasicsQ2Question": "A Loss of Separation means:",
  "@separationBasicsQ2Question": {},
  "separationBasicsQ2O0": "An aircraft changed frequency",
  "@separationBasicsQ2O0": {},
  "separationBasicsQ2O1": "The minimum required distance was not maintained",
  "@separationBasicsQ2O1": {},
  "separationBasicsQ2O2": "A pilot requested descent",
  "@separationBasicsQ2O2": {},
  "separationBasicsQ2Explanation": "Loss of separation occurs when aircraft come closer than the prescribed minimum, which is a serious safety event.",
  "@separationBasicsQ2Explanation": {},
  "separationBasicsQ3Question": "Longitudinal separation refers to:",
  "@separationBasicsQ3Question": {},
  "separationBasicsQ3O0": "Aircraft at different altitudes",
  "@separationBasicsQ3O0": {},
  "separationBasicsQ3O1": "Aircraft separated in the direction of flight",
  "@separationBasicsQ3O1": {},
  "separationBasicsQ3O2": "Aircraft at different airports",
  "@separationBasicsQ3O2": {},
  "separationBasicsQ3Explanation": "Longitudinal separation maintains distance between aircraft flying one behind the other on the same route.",
  "@separationBasicsQ3Explanation": {},

  "runwayOperationsTitle": "Runway Operations",
  "@runwayOperationsTitle": {},
  "runwayOperationsSummary": "Runway safety is the highest priority in airport operations.",
  "@runwayOperationsSummary": {},
  "runwayOperationsPoint1": "Runways are designated by magnetic heading (e.g., Runway 27L means 270° heading, left of parallel).",
  "@runwayOperationsPoint1": {},
  "runwayOperationsPoint2": "Runway incursion: an unauthorised presence on the runway — a top safety concern.",
  "@runwayOperationsPoint2": {},
  "runwayOperationsPoint3": "Tower sequencing: controllers manage arrivals and departures to maximise runway throughput safely.",
  "@runwayOperationsPoint3": {},
  "runwayOperationsQ1Question": "Runway 09 points towards which direction?",
  "@runwayOperationsQ1Question": {},
  "runwayOperationsQ1O0": "West (270°)",
  "@runwayOperationsQ1O0": {},
  "runwayOperationsQ1O1": "East (090°)",
  "@runwayOperationsQ1O1": {},
  "runwayOperationsQ1O2": "North (360°)",
  "@runwayOperationsQ1O2": {},
  "runwayOperationsQ1Explanation": "Runway numbers indicate the magnetic heading in tens of degrees. Runway 09 = 090° = East.",
  "@runwayOperationsQ1Explanation": {},
  "runwayOperationsQ2Question": "What is a runway incursion?",
  "@runwayOperationsQ2Question": {},
  "runwayOperationsQ2O0": "A normal landing procedure",
  "@runwayOperationsQ2O0": {},
  "runwayOperationsQ2O1": "Any unauthorised presence on an active runway",
  "@runwayOperationsQ2O1": {},
  "runwayOperationsQ2O2": "A runway lighting failure",
  "@runwayOperationsQ2O2": {},
  "runwayOperationsQ2Explanation": "A runway incursion is any occurrence where an aircraft, vehicle, or person is on a runway without clearance.",
  "@runwayOperationsQ2Explanation": {},
  "runwayOperationsQ3Question": "Who is responsible for runway sequencing at an airport?",
  "@runwayOperationsQ3Question": {},
  "runwayOperationsQ3O0": "The airline operations centre",
  "@runwayOperationsQ3O0": {},
  "runwayOperationsQ3O1": "The Tower controller",
  "@runwayOperationsQ3O1": {},
  "runwayOperationsQ3O2": "The ground handling agent",
  "@runwayOperationsQ3O2": {},
  "runwayOperationsQ3Explanation": "The Tower controller manages all runway movements — takeoffs, landings, and crossing traffic.",
  "@runwayOperationsQ3Explanation": {},

  "atcPhraseologyTitle": "ATC Phraseology",
  "@atcPhraseologyTitle": {},
  "atcPhraseologySummary": "Standard phrases prevent misunderstandings and ensure clear, efficient communication.",
  "@atcPhraseologySummary": {},
  "atcPhraseologyPoint1": "\"Cleared\" means ATC authorises an action. Never act without a clearance.",
  "@atcPhraseologyPoint1": {},
  "atcPhraseologyPoint2": "Read-back required: pilots must repeat key instructions to confirm correct receipt.",
  "@atcPhraseologyPoint2": {},
  "atcPhraseologyPoint3": "ICAO standard phraseology is used globally to minimise language barrier errors.",
  "@atcPhraseologyPoint3": {},
  "atcPhraseologyQ1Question": "If a pilot does not read back a clearance, what should the controller do?",
  "@atcPhraseologyQ1Question": {},
  "atcPhraseologyQ1O0": "Assume the pilot understood",
  "@atcPhraseologyQ1O0": {},
  "atcPhraseologyQ1O1": "Re-issue the clearance and request read-back",
  "@atcPhraseologyQ1O1": {},
  "atcPhraseologyQ1O2": "Transfer to another frequency",
  "@atcPhraseologyQ1O2": {},
  "atcPhraseologyQ1Explanation": "Read-back is essential for safety. The controller must ensure the clearance is correctly acknowledged.",
  "@atcPhraseologyQ1Explanation": {},
  "atcPhraseologyQ2Question": "The word \"CLEARED\" in ATC means:",
  "@atcPhraseologyQ2Question": {},
  "atcPhraseologyQ2O0": "Visibility is good",
  "@atcPhraseologyQ2O0": {},
  "atcPhraseologyQ2O1": "Authorised to proceed as specified",
  "@atcPhraseologyQ2O1": {},
  "atcPhraseologyQ2O2": "The aircraft is clean (no flaps)",
  "@atcPhraseologyQ2O2": {},
  "atcPhraseologyQ2Explanation": "\"Cleared\" is an ATC authorisation for a specific action, such as takeoff, landing, or a route.",
  "@atcPhraseologyQ2Explanation": {},
  "atcPhraseologyQ3Question": "Why is ICAO standard phraseology important?",
  "@atcPhraseologyQ3Question": {},
  "atcPhraseologyQ3O0": "It makes flights faster",
  "@atcPhraseologyQ3O0": {},
  "atcPhraseologyQ3O1": "It reduces misunderstandings across language barriers",
  "@atcPhraseologyQ3O1": {},
  "atcPhraseologyQ3O2": "It is only used in Europe",
  "@atcPhraseologyQ3O2": {},
  "atcPhraseologyQ3Explanation": "Standard phraseology gives controllers and pilots a shared language, reducing the risk of miscommunication.",
  "@atcPhraseologyQ3Explanation": {},

  "flightPhasesTitle": "Flight Phases",
  "@flightPhasesTitle": {},
  "flightPhasesSummary": "Each phase of flight involves different controllers and procedures.",
  "@flightPhasesSummary": {},
  "flightPhasesPoint1": "Pre-departure → Clearance Delivery → Ground → Tower → Departure → En-route → Approach → Tower → Parking.",
  "@flightPhasesPoint1": {},
  "flightPhasesPoint2": "Each handoff between controllers must include position, altitude, and clearance information.",
  "@flightPhasesPoint2": {},
  "flightPhasesPoint3": "The en-route phase (cruise) covers the longest segment and is managed by Area Control Centres (ACC).",
  "@flightPhasesPoint3": {},
  "flightPhasesQ1Question": "Which controller handles an aircraft during cruise between airports?",
  "@flightPhasesQ1Question": {},
  "flightPhasesQ1O0": "Tower controller",
  "@flightPhasesQ1O0": {},
  "flightPhasesQ1O1": "En-route (ACC) controller",
  "@flightPhasesQ1O1": {},
  "flightPhasesQ1O2": "Ground controller",
  "@flightPhasesQ1O2": {},
  "flightPhasesQ1Explanation": "The en-route controller at an Area Control Centre (ACC) manages aircraft during the cruise phase.",
  "@flightPhasesQ1Explanation": {},
  "flightPhasesQ2Question": "What must be included in a controller handoff?",
  "@flightPhasesQ2Question": {},
  "flightPhasesQ2O0": "Passenger count only",
  "@flightPhasesQ2O0": {},
  "flightPhasesQ2O1": "Position, altitude, and clearance information",
  "@flightPhasesQ2O1": {},
  "flightPhasesQ2O2": "Aircraft colour and type only",
  "@flightPhasesQ2O2": {},
  "flightPhasesQ2Explanation": "A proper handoff ensures the receiving controller has all information needed to maintain safe separation.",
  "@flightPhasesQ2Explanation": {},
  "flightPhasesQ3Question": "Clearance Delivery is used to:",
  "@flightPhasesQ3Question": {},
  "flightPhasesQ3O0": "Approve the aircraft's route and flight plan before taxi",
  "@flightPhasesQ3O0": {},
  "flightPhasesQ3O1": "Load bags into the aircraft",
  "@flightPhasesQ3O1": {},
  "flightPhasesQ3O2": "Refuel the aircraft",
  "@flightPhasesQ3O2": {},
  "flightPhasesQ3Explanation": "Clearance Delivery is the first ATC contact for departing flights, issuing the route, squawk code, and departure instructions.",
  "@flightPhasesQ3Explanation": {},

  "conflictAwarenessTitle": "Conflict Awareness",
  "@conflictAwarenessTitle": {},
  "conflictAwarenessSummary": "Recognising and resolving conflicts early is a key controller skill.",
  "@conflictAwarenessSummary": {},
  "conflictAwarenessPoint1": "STCA (Short-Term Conflict Alert) warns controllers when aircraft are projected to come too close.",
  "@conflictAwarenessPoint1": {},
  "conflictAwarenessPoint2": "Resolution options: change heading, speed, or altitude of one or both aircraft.",
  "@conflictAwarenessPoint2": {},
  "conflictAwarenessPoint3": "Proactive planning — anticipating conflicts before they develop — reduces workload and risk.",
  "@conflictAwarenessPoint3": {},
  "conflictAwarenessQ1Question": "What does STCA stand for?",
  "@conflictAwarenessQ1Question": {},
  "conflictAwarenessQ1O0": "Short-Term Conflict Alert",
  "@conflictAwarenessQ1O0": {},
  "conflictAwarenessQ1O1": "Standard Traffic Control Announcement",
  "@conflictAwarenessQ1O1": {},
  "conflictAwarenessQ1O2": "Speed and Track Control Aid",
  "@conflictAwarenessQ1O2": {},
  "conflictAwarenessQ1Explanation": "STCA is a safety net tool that alerts controllers when aircraft are predicted to lose separation.",
  "@conflictAwarenessQ1Explanation": {},
  "conflictAwarenessQ2Question": "Which of these resolves a conflict between two aircraft at the same altitude and converging?",
  "@conflictAwarenessQ2Question": {},
  "conflictAwarenessQ2O0": "Asking both pilots to speed up",
  "@conflictAwarenessQ2O0": {},
  "conflictAwarenessQ2O1": "Issuing a climb to one aircraft",
  "@conflictAwarenessQ2O1": {},
  "conflictAwarenessQ2O2": "Changing the callsign of one aircraft",
  "@conflictAwarenessQ2O2": {},
  "conflictAwarenessQ2Explanation": "Assigning a different altitude provides immediate vertical separation between conflicting aircraft.",
  "@conflictAwarenessQ2Explanation": {},
  "conflictAwarenessQ3Question": "Proactive conflict management means:",
  "@conflictAwarenessQ3Question": {},
  "conflictAwarenessQ3O0": "Waiting until STCA triggers before acting",
  "@conflictAwarenessQ3O0": {},
  "conflictAwarenessQ3O1": "Anticipating conflicts and resolving them early",
  "@conflictAwarenessQ3O1": {},
  "conflictAwarenessQ3O2": "Relying on pilots to avoid each other",
  "@conflictAwarenessQ3O2": {},
  "conflictAwarenessQ3Explanation": "Good controllers anticipate conflicts from the traffic picture and resolve them before they become critical.",
  "@conflictAwarenessQ3Explanation": {},

  "towerApproachEnrouteTitle": "Tower, Approach, and En-route",
  "@towerApproachEnrouteTitle": {},
  "towerApproachEnrouteSummary": "Three main ATC units each control a distinct phase and volume of airspace.",
  "@towerApproachEnrouteSummary": {},
  "towerApproachEnroutePoint1": "Tower (TWR): controls the manoeuvring area — runways, taxiways, and the airport circuit.",
  "@towerApproachEnroutePoint1": {},
  "towerApproachEnroutePoint2": "Approach (APP): manages arrivals and departures in the Terminal Manoeuvring Area (TMA), typically up to FL100–FL245.",
  "@towerApproachEnroutePoint2": {},
  "towerApproachEnroutePoint3": "En-route (ACC): controls cruise traffic in upper airspace, often from FL245 and above.",
  "@towerApproachEnroutePoint3": {},
  "towerApproachEnrouteQ1Question": "Which unit controls aircraft on the taxiway?",
  "@towerApproachEnrouteQ1Question": {},
  "towerApproachEnrouteQ1O0": "Area Control Centre (ACC)",
  "@towerApproachEnrouteQ1O0": {},
  "towerApproachEnrouteQ1O1": "Tower (TWR)",
  "@towerApproachEnrouteQ1O1": {},
  "towerApproachEnrouteQ1O2": "Approach (APP)",
  "@towerApproachEnrouteQ1O2": {},
  "towerApproachEnrouteQ1Explanation": "Tower (TWR) controls ground movement including taxiways, holding points, and the active runway.",
  "@towerApproachEnrouteQ1Explanation": {},
  "towerApproachEnrouteQ2Question": "TMA stands for:",
  "@towerApproachEnrouteQ2Question": {},
  "towerApproachEnrouteQ2O0": "Terminal Manoeuvring Area",
  "@towerApproachEnrouteQ2O0": {},
  "towerApproachEnrouteQ2O1": "Traffic Management Authority",
  "@towerApproachEnrouteQ2O1": {},
  "towerApproachEnrouteQ2O2": "Tower Monitoring Area",
  "@towerApproachEnrouteQ2O2": {},
  "towerApproachEnrouteQ2Explanation": "TMA (Terminal Manoeuvring Area) is the controlled airspace around busy airports, managed by Approach control.",
  "@towerApproachEnrouteQ2Explanation": {},
  "towerApproachEnrouteQ3Question": "At what level does en-route control typically begin?",
  "@towerApproachEnrouteQ3Question": {},
  "towerApproachEnrouteQ3O0": "Ground level",
  "@towerApproachEnrouteQ3O0": {},
  "towerApproachEnrouteQ3O1": "Around FL245 and above",
  "@towerApproachEnrouteQ3O1": {},
  "towerApproachEnrouteQ3O2": "At exactly FL100",
  "@towerApproachEnrouteQ3O2": {},
  "towerApproachEnrouteQ3Explanation": "En-route (ACC) control typically begins around FL245, though this varies by country and airspace design.",
  "@towerApproachEnrouteQ3Explanation": {},

  "futureAtmTitle": "Future ATM & Automation",
  "@futureAtmTitle": {},
  "futureAtmSummary": "The future of ATM is digital, connected, and increasingly automated — but humans remain central.",
  "@futureAtmSummary": {},
  "futureAtmPoint1": "SESAR (Europe) and NextGen (USA) are programmes modernising ATM with digital data links and 4D trajectories.",
  "@futureAtmPoint1": {},
  "futureAtmPoint2": "Remote towers allow controllers to manage smaller airports from centralised facilities.",
  "@futureAtmPoint2": {},
  "futureAtmPoint3": "AI tools can assist with conflict detection, flow optimisation, and workload balancing — but require careful validation.",
  "@futureAtmPoint3": {},
